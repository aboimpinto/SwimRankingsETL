[Unit]
Description=Refresh official swimming records and publish AWS SwimProfiles data
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/swimrankings-records/environment
ExecStart=/bin/bash -c 'exec /bin/bash "$ETL_ROOT/ops/refresh-records-aws.sh"'
TimeoutStartSec=2h
UMask=0077
Nice=10
